# Frontend Environment Variables Configuration Example
# Copy this file to '.env' and provide your actual values for local development.

# Base URL of the deployed Azure Function API
VITE_API_BASE_URL=http://localhost:7071

# Google reCAPTCHA v2 "I'm not a robot" checkbox public Site Key
VITE_RECAPTCHA_SITE_KEY=<YOUR_RECAPTCHA_SITE_KEY>
